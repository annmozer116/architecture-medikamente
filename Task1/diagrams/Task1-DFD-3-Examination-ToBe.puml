@startuml Task1-DFD-3-Examination-ToBe
!theme plain
title DFD To-Be: Проведение осмотра/диагностики (с мерами безопасности из Task1.md)

skinparam defaultFontSize 11
skinparam rectangle {
  roundCorner 12
  backgroundColor #E8F4FD
}
skinparam database {
  backgroundColor #FFF4E6
}

actor "Пациент\n(Patient)" as Patient
actor "Доктор\n(RBAC: только свои приёмы)" as Doctor

rectangle "3.0\nИдентифицировать\nпациента по записи" as P0 #E8F4FD
rectangle "3.1\nОткрыть данные\nпациента" as P1 #E8F4FD
rectangle "3.2\nПровести осмотр,\nобновить данные" as P2 #E8F4FD
rectangle "3.3\nПросмотреть результаты\nанализов" as P3 #E8F4FD
rectangle "Проверка прав\n(ABAC: врач — только\nсвои приёмы/назначения)" as RBAC #D4EDDA
rectangle "Аудит CRUD\nпо меддокументам" as Audit #FFF3CD

database "Журнал записей\n(минимальные ID)" as D0
database "Медданные пациента\n(отдельная схема/хранилище,\nTLS, шифрование в покое,\nтеги PHI)" as D1
database "Результаты анализов\n(хранилище, шифрование,\nтег PHI_biometry)" as D2
database "Лог аудита\n(доступ к PHI)" as D3

Patient --> Doctor : приход на осмотр\nФИО, дата рождения\n(для идентификации)

Doctor --> RBAC : запрос доступа
RBAC --> P0 : разрешено\n(только свои приёмы)
RBAC --> P1 : разрешено
RBAC --> P2 : разрешено
RBAC --> P3 : разрешено

Doctor --> P0 : ФИО, дата рождения
P0 --> D0 : просмотреть записи
D0 --> P0 : записи с идентификацией пациента

P0 --> P1 : ФИО пациента
P1 --> D1 : открыть (TLS)
D1 --> P1 : история, диагнозы,\nпредыдущие осмотры

P2 --> D1 : обновить данные\nпосле осмотра
P2 --> D0 : обновить отметку\nо состоявшейся записи

P3 --> D2 : открыть (TLS)
D2 --> P3 : результаты\nанализов пациента

P1 --> P2 : данные пациента
P2 --> P3 : при необходимости\nрезультаты анализов

P1 --> Audit : чтение
P2 --> Audit : изменение
P3 --> Audit : чтение
Audit --> D3 : лог (алерты на\nмассовое чтение/экспорт)

note bottom of D1
  Изоляция медданных: только врач к своим приёмам.
  Ресепшен/колл-центр без доступа к PHI.
  Тегирование PHI на все поля с диагнозами и результатами.
end note

@enduml
