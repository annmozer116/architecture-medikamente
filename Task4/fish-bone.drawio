        </mxCell>
        <mxCell id="SvekcRVwHMByA5CnrFnE-31" value="Сопротивление изменениям у ресепшена, кассиров, врачей: ошибки при&lt;div&gt;&amp;nbsp;переходе на новые порталы и процессы&lt;/div&gt;" style="html=1;shadow=0;dashed=0;align=center;verticalAlign=middle;shape=mxgraph.arrows2.arrow;dy=0.5;dx=15;direction=north;notch=0;rounded=0;strokeWidth=1;fontSize=10;rotation=90;horizontal=0;labelPosition=left;verticalLabelPosition=middle;" vertex="1" parent="1">
