        </mxCell>
        <mxCell id="SvekcRVwHMByA5CnrFnE-30" value="Очень маленькая команда (3 человека в IT): сроки разработки высокие" style="html=1;shadow=0;dashed=0;align=center;verticalAlign=middle;shape=mxgraph.arrows2.arrow;dy=0.5;dx=15;direction=north;notch=0;rounded=0;strokeWidth=1;fontSize=10;rotation=90;horizontal=0;labelPosition=left;verticalLabelPosition=middle;" vertex="1" parent="1">
