        <mxCell id="SvekcRVwHMByA5CnrFnE-37" value="Данные" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;fontSize=20;textShadow=0;" vertex="1" parent="1">
